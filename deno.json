{
  "nodeModulesDir": "auto",
  "unstable": ["sloppy-imports"],
  "imports": {
    "@paperback/types": "npm:@paperback/types@^0.8.0-alpha.47",
    "@std/fs": "jsr:@std/fs@^1.0.19",
    "@std/path": "jsr:@std/path@^1.1.2"
  },
  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable"],
    "strict": true
  },
  "fmt": {
    "exclude": ["bundles", "node_modules", "experiment"]
  },
  "exclude": ["bundles", "node_modules", "experiment"],
  "tasks": {
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "check": "deno check src/ tools/ lib/",
    "bundle": "deno run --allow-read --allow-write --allow-env --allow-run tools/bundle.ts",
    "conformance": "deno fmt --check && deno check src/ tools/ lib/",
    "crypto:pipeline": "deno run -A experiment/crypto-pipeline/run.ts",
    "crypto:refresh": "deno run -A experiment/RefreshComixBundle.ts"
  }
}
